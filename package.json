{
  "name": "event-app-working",
  "version": "1.0.0",
  "description": "A warm, zoomable campus event map prototype for BITS Hyderabad. Includes academic block labels A\u2013J, category-coloured event pins, event posting, filters, local RSVPs, and an optional empty-classroom layer.",
  "scripts": {
    "start": "python3 -m http.server 3017 --bind 127.0.0.1",
    "format": "prettier --write index.html src tests package.json playwright.config.js README.md",
    "format:check": "prettier --check index.html src tests package.json playwright.config.js README.md",
    "test": "node --test tests/unit/*.test.js",
    "test:browser": "playwright test",
    "build:vendor": "esbuild scripts/supabase-entry.js --bundle --format=esm --platform=browser --minify --outfile=public/vendor/supabase.js",
    "test:reports-db": "node --test tests/database/event-reports.test.js",
    "test:time-db": "node --test tests/database/event-time-view.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/P27199077/event-app-working.git"
  },
  "keywords": [],
  "author": "",
  "bugs": {
    "url": "https://github.com/P27199077/event-app-working/issues"
  },
  "homepage": "https://github.com/P27199077/event-app-working#readme",
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@playwright/test": "^1.64.1",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10"
  },
  "private": true,
  "type": "module",
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0"
  }
}
